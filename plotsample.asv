clear
clc

R = readtable("R_data.csv");
G = readtable("G_data.csv");
B = readtable("B_data.csv");
Pressure = readtable("Cuff_data.csv");

figure(1)
plot(R,"R0")
hold on
plot(R,"R1")
plot(R,"R2")
plot(G,"G0")
plot(G,"G1")
plot(G,"G2")
plot(B,"B0")
plot(B,"B1")
plot(B,"B2")

figure(2)
plot(Pressure,"Cuff")

R_sgf = sgolayfilt(double(R,3,11);
G_sgf = sgolayfilt(G,3,11);
B_sgf = sgolayfilt(B,3,11);

figure(3)

